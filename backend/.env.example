FRONTEND_URL=http://localhost:3000

# AWS
AWS_REGION=ap-northeast-1

# Cognito
COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXXXX
COGNITO_CLIENT_ID=<your-client-id>
COGNITO_CLIENT_SECRET=<your-client-secret>
COGNITO_DOMAIN=https://<your-domain>.auth.ap-northeast-1.amazoncognito.com
COGNITO_REDIRECT_URI=http://localhost:3000/callback

# PostgreSQL（Drizzle が DATABASE_URL で接続）
DATABASE_URL=postgresql://newsnap:<your-password>@localhost:5432/newsnap

# NewsAPI
NEWS_API_KEY=<your-newsapi-key>
