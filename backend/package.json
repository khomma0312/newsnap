    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "jose": "^6.2.3",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@hono/eslint-config": "^2.1.0",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "vitest": "^3.0.0"
